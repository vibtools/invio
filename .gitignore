# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Build output
build/
dist/
# Approved source helpers live under scripts/build and must remain tracked.
!scripts/build/
!scripts/build/*.py
!scripts/build/.gitkeep
*.spec
*.egg-info/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime data
*.log
data/runtime/
data/exports/

# Installed provider registry is local runtime state.
providers/registry/*
!providers/registry/.gitkeep

# Personal development material remains ignored by default.
# Narrow exception: repository contract tests require these historical root-cause
# verification records to exist in a clean GitHub Actions checkout.
/project/
!/project/
/project/*
!/project/research/
/project/research/*
!/project/research/ROOT_CAUSE_VERIFICATION_v1.0.0.1.47.0.md
!/project/research/ROOT_CAUSE_VERIFICATION_v1.0.0.1.48.0.md
!/project/research/ROOT_CAUSE_VERIFICATION_v1.0.0.1.48.01.md
!/project/research/ROOT_CAUSE_VERIFICATION_v1.0.0.1.48.02.md
